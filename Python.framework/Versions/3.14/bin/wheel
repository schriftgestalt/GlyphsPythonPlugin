#!/bin/sh
'''exec' "$(dirname "$0")/python3.14" "$0" "$@"
' '''
# the above calls the python3.14 interpreter relative to the directory of this script
import sys
from wheel.cli import main
if __name__ == '__main__':
    if sys.argv[0].endswith('.exe'):
        sys.argv[0] = sys.argv[0][:-4]
    sys.exit(main())
